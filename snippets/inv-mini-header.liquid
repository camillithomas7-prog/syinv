<header class="hdr sc"><div class="wrap"><a class="logo" href="{{ routes.root_url }}"><img src="{{ 'logo-invitelle.png' | asset_url }}" alt="" width="34" height="34"><b>Invitelle</b></a>
<a class="btn" href="{{ routes.root_url }}#prezzo" style="margin-left:auto;padding:11px 20px;font-size:14px">Crea il tuo invito</a></div></header>
<style>.simple{padding:70px 0 90px;min-height:55vh}.simple h1{font-size:clamp(34px,5vw,52px);margin-bottom:24px}.simple .rte{color:var(--ink2);max-width:760px}.simple .rte a{color:var(--brand)}
.simple table{width:100%;border-collapse:collapse}.simple td,.simple th{padding:14px 8px;border-bottom:1px solid var(--line);text-align:left}
.simple input:not([type=hidden]),.simple textarea{width:100%;max-width:440px;padding:13px 14px;border:1px solid var(--line);border-radius:12px;font:inherit;background:#fff;margin:4px 0 14px}
.simple .grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:20px}.simple .card{background:var(--card);border:1px solid var(--line);border-radius:var(--r);padding:18px;text-decoration:none}</style>
