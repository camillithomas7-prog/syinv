{% layout none %}
<!doctype html><html lang="it"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>{{ shop.name }}</title>
{{ 'invitelle.css' | asset_url | stylesheet_tag }}{{ content_for_header }}</head>
<body><main class="simple" style="text-align:center"><div class="wrap">
<img src="{{ 'logo-invitelle.png' | asset_url }}" alt="" width="70" height="70" style="margin:0 auto 16px"><h1>Invitelle</h1><p>{{ shop.password_message | default: 'Stiamo arrivando.' }}</p>
{%- form 'storefront_password' -%}{{ form.errors | default_errors }}<input type="password" name="password" placeholder="Password"><br><button class="btn" type="submit">Entra</button>{%- endform -%}
</div></main></body></html>
