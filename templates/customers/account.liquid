<main class="simple"><div class="wrap">
<h1>Il tuo account</h1><p>{{ customer.email }}</p><table>{%- for o in customer.orders -%}<tr><td><a href="{{ o.customer_url }}">{{ o.name }}</a></td><td>{{ o.created_at | date: '%d/%m/%Y' }}</td><td>{{ o.total_price | money }}</td></tr>{%- endfor -%}</table><p><a href="{{ routes.account_logout_url }}">Esci</a></p>
</div></main>
